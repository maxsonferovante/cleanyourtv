<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="com.gathin.tvhome.permission.ACCESS_WEATHER_PANEL" />

    <queries>
        <package android:name="com.gathin.tvhome" />
    </queries>

    <!-- Network permission: Open-Meteo, for the place search, the weather and the air quality. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".WeatherActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Clean Your TV module card (docs/specs/card.md): the tile shows as "Weather" once the owner says Show. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- Bound-only CleanYourTV Home panel endpoint. Requests are checked against the caller's Android UID. -->
        <service
            android:name=".HomePanelService"
            android:exported="true"
            android:permission="com.gathin.tvhome.permission.ACCESS_WEATHER_PANEL">
            <intent-filter>
                <action android:name="io.github.sumyabazar1.weather.HOME_PANEL" />
            </intent-filter>
        </service>
    </application>
</manifest>
